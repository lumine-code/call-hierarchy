{
  "name": "call-hierarchy",
  "author": "lumine-code",
  "description": "Explore incoming and outgoing calls for a symbol.",
  "repository": "https://github.com/lumine-code/call-hierarchy",
  "bugs": {
    "url": "https://github.com/lumine-code/call-hierarchy/issues"
  },
  "keywords": [
    "callers",
    "callees",
    "incoming-calls",
    "outgoing-calls",
    "navigation",
    "lsp"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../../lumine && npm run test:only -- ../pkg_lumine/call-hierarchy/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "ide-client": {
      "versions": {
        "^1.0.0": "consumeIdeClient"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "dockSide": {
      "title": "Dock Side",
      "description": "The dock in which the call hierarchy opens.",
      "type": "string",
      "enum": [
        "left",
        "right"
      ],
      "default": "right"
    }
  }
}
